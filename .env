# Copia este archivo a ".env" y completa los valores. ".env" está en .gitignore.
# Usa comillas simples si la contraseña contiene #, $ o espacios.
SIMCA_USER='tu_usuario'
SIMCA_PASSWORD='tu_contraseña'

# Opcional: código/cédula del estudiante a consultar (también se puede digitar en la UI)
SIMCA_STUDENT_CODE=

# Opcional: código de acceso a la app (obligatorio si la publicas en la nube)
# SIMCA_APP_ACCESS_CODE='un-codigo-largo-y-unico'

# Opcional
# SIMCA_BASE_URL=https://simca.unicauca.edu.co/simca/
# SIMCA_HEADLESS=true
# SIMCA_DEBUG=0
# Carpeta local para config/snapshot. Recomendado: una ruta FUERA del repositorio.
# SIMCA_DATA_DIR=C:/Users/tu_usuario/.simca_analytics
